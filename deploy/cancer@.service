[Unit]
Description=Cancer workbench (%i)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=cancer-%i
Group=cancer-%i
WorkingDirectory=/srv/cancer-%i/current
EnvironmentFile=/etc/cancer/%i.env
EnvironmentFile=/srv/cancer-%i/current/release.env
Environment=MPLBACKEND=Agg
Environment=MPLCONFIGDIR=/var/lib/cancer-%i/cache/matplotlib
Environment=XDG_CACHE_HOME=/var/lib/cancer-%i/cache
Environment=TORCH_HOME=/var/lib/cancer-%i/cache/torch
Environment=HF_HOME=/var/lib/cancer-%i/cache/huggingface
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/cancer-%i/current/.venv/bin/gunicorn --workers 1 --worker-class gthread --threads 4 --bind ${CANCER_BIND} --timeout 180 --graceful-timeout 60 --access-logfile - --error-logfile - cancer_pipeline.wsgi:create_hosted_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/cancer-%i
MemoryAccounting=true
CPUAccounting=true
TasksMax=128

[Install]
WantedBy=multi-user.target
