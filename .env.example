# Copy this file to .env and fill in your own key.
# Report CLI and local website read the project root .env; exported variables take priority.
DEEPSEEK_API_KEY=

# Local website: trusted ViT checkpoint, optional validation decision, device.
CANCER_MODEL_PATH=
CANCER_DECISION_PATH=
CANCER_DEVICE=auto
DEEPSEEK_MODEL=deepseek-flash

# Report provider: deepseek (legacy settings above) or compatible.
# Any OpenAI-compatible Chat Completions API; change variables, not Python files.
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
